{
  "name": "virustotal-monitor-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that uploads release artifacts to VirusTotal Monitor and prunes old ones to stay under the storage quota",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "all": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StreamElements/virustotal-monitor-action.git"
  },
  "keywords": [
    "actions",
    "virustotal",
    "monitor",
    "release"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/glob": "^0.5.0",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@vercel/ncc": "^0.38.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
